+/// 第 `row` 个视觉行（软换行后）按对齐方式相对 bounds 左边的水平偏移。
+fn aligned_row_offset(line: &WrappedLine, row: usize, align: TextAlign, align_width: Pixels) -> Pixels {
+    if matches!(align, TextAlign::Left) {
