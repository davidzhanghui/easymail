+    let x_at = |b: &crate::WrapBoundary| layout.runs[b.run_ix].glyphs[b.glyph_ix].position.x;
+    let start = if row == 0 { px(0.) } else { line.wrap_boundaries.get(row - 1).map(x_at).unwrap_or(px(0.)) };
